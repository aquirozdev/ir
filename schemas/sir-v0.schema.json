                }
              },
              "required": [
                "kind",
                "entity"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "name",
        "field_type"
      ],
      "additionalProperties": false
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "path"
            },
            "segments": {
              "type": "array",
