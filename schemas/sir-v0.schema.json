            "right": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "op",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "gt"
            },
            "left": {
              "$ref": "#/$defs/expression"
            },
            "right": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "op",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "gte"
            },
            "left": {
              "$ref": "#/$defs/expression"
            },
            "right": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "op",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "lt"
            },
            "left": {
              "$ref": "#/$defs/expression"
            },
            "right": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "op",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "lte"
            },
            "left": {
              "$ref": "#/$defs/expression"
            },
            "right": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "op",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "and"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
