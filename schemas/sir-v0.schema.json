      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "maxLength": 64
        },
        "field_type": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "string"
                }
              },
              "required": [
