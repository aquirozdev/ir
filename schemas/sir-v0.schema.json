              },
              "minItems": 1,
              "maxItems": 8
            }
          },
          "required": [
            "op",
            "segments"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "literal"
            },
            "value": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "string"
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
