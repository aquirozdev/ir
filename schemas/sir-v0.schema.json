          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "not"
            },
            "arg": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "op",
